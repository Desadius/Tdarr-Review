# Copy to .env and set the paths for YOUR server before starting.
REVIEW_BIND_IP=127.0.0.1
REVIEW_PORT=8270
REVIEW_IMAGE_TAG=1.11.0
RECOVERY_IMAGE_TAG=1.11.0
PUBLIC_ORIGIN=http://localhost:8270
TDARR_URL=http://YOUR_UNRAID_IP:8266
PUID=99
PGID=100
MEDIA_HOST=/mnt/user/media
REVIEW_HOST=/mnt/cache/tdarr-review-output
TDARR_DB_HOST=/mnt/cache/appdata/tdarr/server/Tdarr/DB2
TDARR_REPORTS_HOST=/mnt/cache/appdata/tdarr/server/Tdarr/DB2/JobReports
REVIEW_DATA_HOST=/mnt/cache/appdata/tdarr-review/data
RECOVERY_DATA_HOST=/mnt/cache/appdata/tdarr-recovery/data
