ARG TDARR_RUNTIME_IMAGE=ghcr.io/haveagitgat/tdarr@sha256:45742f00e51a58553844c8b13d97e7ae9b2ee9a056bd8e5993d9a8282a45a23f
FROM ${TDARR_RUNTIME_IMAGE}
WORKDIR /app-recovery
COPY recovery/ /app-recovery/
ENV DATA_ROOT=/data
USER 99:100
ENTRYPOINT ["/usr/bin/ionice"]
CMD ["-c", "2", "-n", "7", "/usr/bin/nice", "-n", "19", "/usr/bin/node", "/app-recovery/worker.mjs"]
