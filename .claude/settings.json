{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch origin *)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(git push --set-upstream origin *)"
    ],
    "ask": [
      "Bash(gh * --repo *)",
      "Bash(gh * -R *)",
      "Bash(gh issue close *)",
      "Bash(rm *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push * --delete *)",
      "Bash(git push * -d *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push * --mirror*)",
      "Bash(git push * --prune*)"
    ]
  }
}
